FROM golang:1.25@sha256:cbff9d1a9041b316010f2da6b701b6c0d597718cb90928c85eb597334a0d23d4 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/ember-fake-gpu ./cmd/fake-gpu-plugin

FROM scratch
COPY --from=build /out/ember-fake-gpu /ember-fake-gpu
ENTRYPOINT ["/ember-fake-gpu"]
