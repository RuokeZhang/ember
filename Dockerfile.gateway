FROM golang:1.24@sha256:d2d2bc1c84f7e60d7d2438a3836ae7d0c847f4888464e7ec9ba3a1339a1ee804 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/ember-gateway ./gateway/cmd/gateway

FROM scratch
COPY --from=build /out/ember-gateway /ember-gateway
ENTRYPOINT ["/ember-gateway"]
