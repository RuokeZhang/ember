FROM golang:1.25@sha256:cbff9d1a9041b316010f2da6b701b6c0d597718cb90928c85eb597334a0d23d4 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/ember-mock-engine ./cmd/mock-engine

FROM scratch
COPY --from=build /out/ember-mock-engine /ember-mock-engine
USER 65532:65532
EXPOSE 8000
ENTRYPOINT ["/ember-mock-engine"]
