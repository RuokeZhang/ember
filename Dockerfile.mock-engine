FROM golang:1.24 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/ember-mock-engine ./cmd/mock-engine

FROM scratch
COPY --from=build /out/ember-mock-engine /ember-mock-engine
USER 65532:65532
EXPOSE 8000
ENTRYPOINT ["/ember-mock-engine"]
