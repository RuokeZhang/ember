FROM golang:1.24@sha256:d2d2bc1c84f7e60d7d2438a3836ae7d0c847f4888464e7ec9ba3a1339a1ee804 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/ember-mock-engine ./cmd/mock-engine

FROM scratch
COPY --from=build /out/ember-mock-engine /ember-mock-engine
USER 65532:65532
EXPOSE 8000
ENTRYPOINT ["/ember-mock-engine"]
